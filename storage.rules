rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --- Profile Images ---
    // Anyone authenticated can view profile images.
    // Users can only upload or replace their own profile image.
    match /profile_images/{userId}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024 // Max 5MB
        && request.resource.contentType.matches('image/.*');
    }

    // --- Post Images ---
    // Anyone authenticated can view post images.
    // Authors can upload post pictures with a 10MB limit.
    match /post_images/{postId}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024 // Max 10MB
        && request.resource.contentType.matches('image/.*');
    }
  }
}
